/* TesterPresent keeps session 0x3 alive at the S3 boundary
 * category=timing template=s3_keepalive_boundary requirements=REQ-015 origin=generated
 */
testcase TC_req_015__tpl_s3_keepalive_03()
{
  testCaseTitle("req_015__tpl_s3_keepalive_03", "TesterPresent keeps session 0x3 alive at the S3 boundary");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Stay silent for exactly S3.
  testWaitForTimeout(5000);
  // step 2: TesterPresent exactly at S3 -> still served.
  {
    byte req2[2] = {0x3E, 0x00};
    byte exp2[2] = {0x7E, 0x00};
    SendAndCheck(req2, 2, exp2, 2, "step 2");
  }
  // step 3: Silent for exactly S3 again (timer restarted by TesterPresent).
  testWaitForTimeout(5000);
  // step 4: Read the active session -> still the non-default session.
  {
    byte req4[3] = {0x22, 0xF1, 0x86};
    byte exp4[4] = {0x62, 0xF1, 0x86, 0x03};
    SendAndCheck(req4, 3, exp4, 4, "step 4");
  }
}

/* Suppress positive response for service 0x3e in session 0x2
 * category=positive template=suppress_positive_response requirements=REQ-015 origin=generated
 */
testcase TC_req_015__tpl_suppress_positive_3e_02()
{
  testCaseTitle("req_015__tpl_suppress_positive_3e_02", "Suppress positive response for service 0x3e in session 0x2");
  // step 0: Switch to session 0x2.
  {
    byte req0[2] = {0x10, 0x02};
    byte exp0[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Suppress-positive-response bit set -> expect no response frame.
  {
    byte req1[2] = {0x3E, 0x80};
    SendAndCheck(req1, 2, req1, 0, "step 1");
  }
}

/* Negative response not suppressed for service 0x3e in session 0x1
 * category=negative template=negative_response_with_suppress_bit requirements=REQ-015 origin=generated
 */
testcase TC_req_015__tpl_negative_suppress_3e_01()
{
  testCaseTitle("req_015__tpl_negative_suppress_3e_01", "Negative response not suppressed for service 0x3e in session 0x1");
  // step 0: Unsupported subfunction 0x1 with the suppress bit set -> the NRC is still sent.
  {
    byte req0[2] = {0x3E, 0x81};
    byte exp0[3] = {0x7F, 0x3E, 0x12};
    SendAndCheck(req0, 2, exp0, 3, "step 0");
  }
}


