/* Replayed SecurityAccess key for level 0x1 is rejected
 * category=security template=seed_replay_rejected requirements=REQ-010 origin=generated
 */
testcase TC_req_010__tpl_seed_replay_01()
{
  testCaseTitle("req_010__tpl_seed_replay_01", "Replayed SecurityAccess key for level 0x1 is rejected");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed.
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send the computed key -> unlocked.
  {
    byte req2[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Replay the same key -> expect NRC 0x24 (the seed was consumed).
  {
    byte req3[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp3[3] = {0x7F, 0x27, 0x24};
    SendAndCheck(req3, 6, exp3, 3, "step 3");
  }
}

