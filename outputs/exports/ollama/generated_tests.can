/* Read and clear injected DTC B10101
 * category=positive template=dtc_read_clear requirements=REQ-014 origin=generated
 */
testcase TC_req_014__tpl_dtc_read_clear_B10101()
{
  testCaseTitle("req_014__tpl_dtc_read_clear_B10101", "Read and clear injected DTC B10101");
  // step 0: TODO provoke DTC B10101 with status 0x09 (simulator-only fault injection)
  // step 1: Read DTCs matching mask 0x09 -> includes the injected DTC.
  {
    byte req1[3] = {0x19, 0x02, 0x09};
    byte exp1[7] = {0x59, 0x02, 0xFF, 0xB1, 0x01, 0x01, 0x09};
    SendAndCheck(req1, 3, exp1, 7, "step 1");
  }
  // step 2: Read DTCs matching mask 0x40 -> excludes the injected DTC.
  {
    byte req2[3] = {0x19, 0x02, 0x40};
    byte exp2[3] = {0x59, 0x02, 0xFF};
    SendAndCheck(req2, 3, exp2, 3, "step 2");
  }
  // step 3: Clear just this DTC.
  {
    byte req3[4] = {0x14, 0xB1, 0x01, 0x01};
    byte exp3[1] = {0x54};
    SendAndCheck(req3, 4, exp3, 1, "step 3");
  }
  // step 4: Read again -> the DTC no longer matches.
  {
    byte req4[3] = {0x19, 0x02, 0x09};
    byte exp4[3] = {0x59, 0x02, 0xFF};
    SendAndCheck(req4, 3, exp4, 3, "step 4");
  }
}

