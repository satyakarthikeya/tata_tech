/* Routine door_actuator_calibration (0x0202) status is cleared by the session change
 * category=session template=session_change_resets_routine requirements=REQ-012 origin=generated
 */
testcase TC_req_012__tpl_routine_after_session_0202()
{
  testCaseTitle("req_012__tpl_routine_after_session_0202", "Routine door_actuator_calibration (0x0202) status is cleared by the session change");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: TODO set environment on the bench: vehicle_speed_kph=0 nvm_write_fault=None
  // step 2: Request seed for level 0x1.
  {
    byte req2[2] = {0x27, 0x01};
    byte exp2[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req2, 2, exp2, 6, "step 2");
  }
  // step 3: Send computed key for level 0x1.
  {
    byte req3[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp3[2] = {0x67, 0x02};
    SendAndCheck(req3, 6, exp3, 2, "step 3");
  }
  // step 4: Start the routine.
  {
    byte req4[5] = {0x31, 0x01, 0x02, 0x02, 0x00};
    byte exp4[5] = {0x71, 0x01, 0x02, 0x02, 0x01};
    SendAndCheck(req4, 5, exp4, 5, "step 4");
  }
  // step 5: Re-enter the session (a positive session change).
  {
    byte req5[2] = {0x10, 0x03};
    byte exp5[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
  // step 6: Unlock again: Request seed for level 0x1.
  {
    byte req6[2] = {0x27, 0x01};
    byte exp6[6] = {0x67, 0x01, 0x32, 0xA3, 0x14, 0x85};
    SendAndCheck(req6, 2, exp6, 6, "step 6");
  }
  // step 7: Unlock again: Send computed key for level 0x1.
  {
    byte req7[6] = {0x27, 0x02, 0xA5, 0x29, 0x96, 0x1A};
    byte exp7[2] = {0x67, 0x02};
    SendAndCheck(req7, 6, exp7, 2, "step 7");
  }
  // step 8: Request results -> the start before the session change no longer counts.
  {
    byte req8[4] = {0x31, 0x03, 0x02, 0x02};
    byte exp8[3] = {0x7F, 0x31, 0x24};
    SendAndCheck(req8, 4, exp8, 3, "step 8");
  }
  // step 9: Start the routine again -> accepted.
  {
    byte req9[5] = {0x31, 0x01, 0x02, 0x02, 0x00};
    byte exp9[5] = {0x71, 0x01, 0x02, 0x02, 0x01};
    SendAndCheck(req9, 5, exp9, 5, "step 9");
  }
}

