/* SecurityAccess level 0x1 lockout after 3 wrong keys
 * category=security template=security_invalid_key_lockout requirements=REQ-005 origin=generated
 */
testcase TC_req_005__tpl_security_lockout_01()
{
  testCaseTitle("req_005__tpl_security_lockout_01", "SecurityAccess level 0x1 lockout after 3 wrong keys");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed, attempt 1.
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send wrong key, attempt 1.
  {
    byte req2[6] = {0x27, 0x02, 0x96, 0x07, 0x78, 0xE9};
    byte exp2[3] = {0x7F, 0x27, 0x35};
    SendAndCheck(req2, 6, exp2, 3, "step 2");
  }
  // step 3: Request seed, attempt 2.
  {
    byte req3[2] = {0x27, 0x01};
    byte exp3[6] = {0x67, 0x01, 0x32, 0xA3, 0x14, 0x85};
    SendAndCheck(req3, 2, exp3, 6, "step 3");
  }
  // step 4: Send wrong key, attempt 2.
  {
    byte req4[6] = {0x27, 0x02, 0x33, 0xA4, 0x15, 0x86};
    byte exp4[3] = {0x7F, 0x27, 0x35};
    SendAndCheck(req4, 6, exp4, 3, "step 4");
  }
  // step 5: Request seed, attempt 3.
  {
    byte req5[2] = {0x27, 0x01};
    byte exp5[6] = {0x67, 0x01, 0xCF, 0x40, 0xB1, 0x22};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
  // step 6: Send wrong key, attempt 3.
  {
    byte req6[6] = {0x27, 0x02, 0xD0, 0x41, 0xB2, 0x23};
    byte exp6[3] = {0x7F, 0x27, 0x36};
