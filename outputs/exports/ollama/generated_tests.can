    byte req0[1] = {0x22};
    byte exp0[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req0, 1, exp0, 3, "step 0");
  }
  // step 1: Only the first byte of DID 0xf190 -> length NRC.
  {
    byte req1[2] = {0x22, 0xF1};
    byte exp1[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req1, 2, exp1, 3, "step 1");
  }
  // step 2: DID 0xf190 plus one dangling byte -> length NRC, no partial answer.
  {
    byte req2[4] = {0x22, 0xF1, 0x90, 0x00};
    byte exp2[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req2, 4, exp2, 3, "step 2");
  }
  // step 3: Well-formed read of the same DID -> served normally.
  {
    byte req3[3] = {0x22, 0xF1, 0x90};
    byte exp3[20] = {0x62, 0xF1, 0x90, 0x53, 0x59, 0x4E, 0x54, 0x48, 0x45, 0x54, 0x49, 0x43, 0x42, 0x4D, 0x30, 0x30, 0x30, 0x30, 0x30, 0x31};
