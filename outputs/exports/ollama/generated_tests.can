/* RoutineControl sequencing for routine 0x0202
 * category=negative template=routine_sequence requirements=REQ-012 origin=generated
 */
testcase TC_req_012__tpl_routine_sequence_0202()
{
  testCaseTitle("req_012__tpl_routine_sequence_0202", "RoutineControl sequencing for routine 0x0202");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: TODO set environment on the bench: vehicle_speed_kph=0 nvm_write_fault=None
  // step 2: Request seed for level 0x1.
  {
    byte req2[2] = {0x27, 0x01};
    byte exp2[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req2, 2, exp2, 6, "step 2");
  }
  // step 3: Send computed key for level 0x1.
  {
    byte req3[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp3[2] = {0x67, 0x02};
    SendAndCheck(req3, 6, exp3, 2, "step 3");
  }
  // step 4: Stop before start -> expect NRC 0x24.
  {
    byte req4[4] = {0x31, 0x02, 0x02, 0x02};
    byte exp4[3] = {0x7F, 0x31, 0x24};
    SendAndCheck(req4, 4, exp4, 3, "step 4");
  }
  // step 5: Start the routine.
  {
    byte req5[5] = {0x31, 0x01, 0x02, 0x02, 0x00};
    byte exp5[5] = {0x71, 0x01, 0x02, 0x02, 0x01};
    SendAndCheck(req5, 5, exp5, 5, "step 5");
  }
  // step 6: Start again while running -> expect NRC 0x24.
  {
    byte req6[5] = {0x31, 0x01, 0x02, 0x02, 0x00};
    byte exp6[3] = {0x7F, 0x31, 0x24};
    SendAndCheck(req6, 5, exp6, 3, "step 6");
  }
  // step 7: Stop the routine.
  {
    byte req7[4] = {0x31, 0x02, 0x02, 0x02};
    byte exp7[5] = {0x71, 0x02, 0x02, 0x02, 0x03};
    SendAndCheck(req7, 4, exp7, 5, "step 7");
  }
  // step 8: Request results after stop.
  {
    byte req8[4] = {0x31, 0x03, 0x02, 0x02};
    byte exp8[5] = {0x71, 0x03, 0x02, 0x02, 0x03};
    SendAndCheck(req8, 4, exp8, 5, "step 8");
  }
}

