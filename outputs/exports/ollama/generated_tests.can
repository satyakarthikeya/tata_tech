/* Session change re-locks security level 0x1
 * category=security template=session_change_relocks_security requirements=REQ-006 origin=generated
 */
testcase TC_req_006__tpl_session_relock_01()
{
  testCaseTitle("req_006__tpl_session_relock_01", "Session change re-locks security level 0x1");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed for level 0x1.
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send computed key for level 0x1.
  {
    byte req2[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Re-enter the same session -> security must be locked again.
  {
    byte req3[2] = {0x10, 0x03};
    byte exp3[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req3, 2, exp3, 6, "step 3");
  }
  // step 4: Secured write to 0x0100 after re-entry -> expect NRC 0x33.
  {
    byte req4[4] = {0x2E, 0x01, 0x00, 0x00};
    byte exp4[3] = {0x7F, 0x2E, 0x33};
    SendAndCheck(req4, 4, exp4, 3, "step 4");
  }
  // step 5: Request seed -> a fresh non-zero seed (level is locked again).
  {
    byte req5[2] = {0x27, 0x01};
    byte exp5[6] = {0x67, 0x01, 0x32, 0xA3, 0x14, 0x85};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
}

/* Negative response not suppressed for service 0x10 in session 0x3
 * category=negative template=negative_response_with_suppress_bit requirements=REQ-006 origin=generated
 */
testcase TC_req_006__tpl_negative_suppress_10_03()
{
  testCaseTitle("req_006__tpl_negative_suppress_10_03", "Negative response not suppressed for service 0x10 in session 0x3");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Unsupported subfunction 0x7 with the suppress bit set -> the NRC is still sent.
  {
    byte req1[2] = {0x10, 0x87};
    byte exp1[3] = {0x7F, 0x10, 0x12};
    SendAndCheck(req1, 2, exp1, 3, "step 1");
  }
}

/* Seed request while security level 0x1 is already unlocked
 * category=security template=seed_request_while_unlocked requirements=REQ-006 origin=generated
 */
testcase TC_req_006__tpl_seed_while_unlocked_01()
{
  testCaseTitle("req_006__tpl_seed_while_unlocked_01", "Seed request while security level 0x1 is already unlocked");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed for level 0x1.
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send computed key for level 0x1.
  {
    byte req2[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Request a seed again while the level is unlocked -> 'already unlocked' seed.
  {
    byte req3[2] = {0x27, 0x01};
    byte exp3[6] = {0x67, 0x01, 0x00, 0x00, 0x00, 0x00};
    SendAndCheck(req3, 2, exp3, 6, "step 3");
  }
  // step 4: Protected write to 0x0100 -> still accepted (level stays unlocked).
  {
    byte req4[4] = {0x2E, 0x01, 0x00, 0x00};
    byte exp4[3] = {0x6E, 0x01, 0x00};
    SendAndCheck(req4, 4, exp4, 3, "step 4");
  }
  // step 5: Request a seed once more -> still the 'already unlocked' answer.
  {
    byte req5[2] = {0x27, 0x01};
    byte exp5[6] = {0x67, 0x01, 0x00, 0x00, 0x00, 0x00};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
}

