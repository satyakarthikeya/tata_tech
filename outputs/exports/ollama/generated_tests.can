/* Write DID interior_lighting_brightness_pct (0x0100) after unlocking level 0x1
 * category=positive template=write_did_secured_positive requirements=REQ-015 origin=generated
 */
testcase TC_req_015__tpl_write_secured_0100()
{
  testCaseTitle("req_015__tpl_write_secured_0100", "Write DID interior_lighting_brightness_pct (0x0100) after unlocking level 0x1");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed for level 0x1.
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send computed key for level 0x1.
  {
    byte req2[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Write 0 to DID 0x0100.
  {
    byte req3[4] = {0x2E, 0x01, 0x00, 0x00};
    byte exp3[3] = {0x6E, 0x01, 0x00};
    SendAndCheck(req3, 4, exp3, 3, "step 3");
  }
  // step 4: Read back to confirm the write.
  {
    byte req4[3] = {0x22, 0x01, 0x00};
    byte exp4[4] = {0x62, 0x01, 0x00, 0x00};
    SendAndCheck(req4, 3, exp4, 4, "step 4");
  }
}

/* TesterPresent keeps session 0x3 alive at the S3 boundary
 * category=timing template=s3_keepalive_boundary requirements=REQ-015 origin=generated
 */
testcase TC_req_015__tpl_s3_keepalive_03()
{
  testCaseTitle("req_015__tpl_s3_keepalive_03", "TesterPresent keeps session 0x3 alive at the S3 boundary");
  // step 0: Switch to session 0x3.
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Stay silent for exactly S3.
  testWaitForTimeout(5000);
  // step 2: TesterPresent exactly at S3 -> still served.
  {
    byte req2[2] = {0x3E, 0x00};
    byte exp2[2] = {0x7E, 0x00};
    SendAndCheck(req2, 2, exp2, 2, "step 2");
  }
  // step 3: Silent for exactly S3 again (timer restarted by TesterPresent).
  testWaitForTimeout(5000);
  // step 4: Read the active session -> still the non-default session.
  {
    byte req4[3] = {0x22, 0xF1, 0x86};
    byte exp4[4] = {0x62, 0xF1, 0x86, 0x03};
    SendAndCheck(req4, 3, exp4, 4, "step 4");
  }
}

