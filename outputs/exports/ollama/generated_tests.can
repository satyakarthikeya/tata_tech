    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Write out-of-range value 101 -> expect NRC 0x31.
  {
    byte req3[4] = {0x2E, 0x01, 0x00, 0x65};
    byte exp3[3] = {0x7F, 0x2E, 0x31};
