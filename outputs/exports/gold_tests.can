    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: send request
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: send request
  {
    byte req2[6] = {0x27, 0x02, 0x00, 0x00, 0x00, 0x01};
    byte exp2[3] = {0x7F, 0x27, 0x35};
    SendAndCheck(req2, 6, exp2, 3, "step 2");
  }
}

