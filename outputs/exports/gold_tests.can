  // step 1: send request
  {
    byte req1[3] = {0x22, 0x01, 0x40};
    byte exp1[4] = {0x62, 0x01, 0x40, 0x2A};
    SendAndCheck(req1, 3, exp1, 4, "step 1");
  }
}

