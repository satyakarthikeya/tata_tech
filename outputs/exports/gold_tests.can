/* S3 timeout reverts session before next request
 * category=timing template=None requirements=- origin=gold
 */
testcase TC_gold_s3_timeout_reverts()
{
  testCaseTitle("gold_s3_timeout_reverts", "S3 timeout reverts session before next request");
  // step 0: send request
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Idle past s3_ms (5000).
  testWaitForTimeout(5001);
  // step 2: send request
  {
    byte req2[3] = {0x22, 0xF1, 0x86};
    byte exp2[4] = {0x62, 0xF1, 0x86, 0x01};
    SendAndCheck(req2, 3, exp2, 4, "step 2");
  }
}

