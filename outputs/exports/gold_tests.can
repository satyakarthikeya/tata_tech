/* Correct key for the wrong level does not unlock it
 * category=security template=None requirements=- origin=gold
 */
testcase TC_gold_security_wrong_level_unlock()
{
  testCaseTitle("gold_security_wrong_level_unlock", "Correct key for the wrong level does not unlock it");
