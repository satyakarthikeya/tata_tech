/* Security is re-locked by any positive 0x10, even same session
 * category=security template=None requirements=- origin=gold
 */
testcase TC_gold_security_relocked_on_session_reentry()
{
  testCaseTitle("gold_security_relocked_on_session_reentry", "Security is re-locked by any positive 0x10, even same session");
  // step 0: send request
  {
    byte req0[2] = {0x10, 0x03};
    byte exp0[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: send request
  {
    byte req1[2] = {0x27, 0x01};
    byte exp1[6] = {0x67, 0x01, 0x95, 0x06, 0x77, 0xE8};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: send request
  {
    byte req2[6] = {0x27, 0x02, 0x9A, 0x06, 0x8F, 0x73};
    byte exp2[2] = {0x67, 0x02};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: send request
  {
    byte req3[4] = {0x2E, 0x01, 0x00, 0x14};
    byte exp3[3] = {0x6E, 0x01, 0x00};
    SendAndCheck(req3, 4, exp3, 3, "step 3");
  }
  // step 4: send request
  {
    byte req4[2] = {0x10, 0x03};
    byte exp4[6] = {0x50, 0x03, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req4, 2, exp4, 6, "step 4");
  }
  // step 5: send request
  {
    byte req5[4] = {0x2E, 0x01, 0x00, 0x14};
    byte exp5[3] = {0x7F, 0x2E, 0x33};
    SendAndCheck(req5, 4, exp5, 3, "step 5");
  }
}


