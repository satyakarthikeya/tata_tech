/* Unlock level 3 in programming session, write 2-byte coding variant
 * category=positive template=None requirements=- origin=gold
 */
testcase TC_gold_write_coding_variant()
{
  testCaseTitle("gold_write_coding_variant", "Unlock level 3 in programming session, write 2-byte coding variant");
  // step 0: send request
  {
    byte req0[2] = {0x10, 0x02};
    byte exp0[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: send request
  {
    byte req1[2] = {0x27, 0x03};
    byte exp1[6] = {0x67, 0x03, 0x0B, 0x7C, 0xED, 0x5E};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: send request
  {
    byte req2[6] = {0x27, 0x04, 0x20, 0xA9, 0x2D, 0xBA};
    byte exp2[2] = {0x67, 0x04};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: send request
  {
    byte req3[5] = {0x2E, 0x01, 0x60, 0x00, 0x05};
    byte exp3[3] = {0x6E, 0x01, 0x60};
    SendAndCheck(req3, 5, exp3, 3, "step 3");
  }
  // step 4: send request
  {
    byte req4[3] = {0x22, 0x01, 0x60};
    byte exp4[5] = {0x62, 0x01, 0x60, 0x00, 0x05};
    SendAndCheck(req4, 3, exp4, 5, "step 4");
  }
}

