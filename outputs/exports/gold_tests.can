/* Long-running NVM factory restore start
 * category=timing template=None requirements=- origin=gold
 */
testcase TC_gold_routine_nvm_restore_long_running()
{
  testCaseTitle("gold_routine_nvm_restore_long_running", "Long-running NVM factory restore start");
  // step 0: send request
  {
    byte req0[2] = {0x10, 0x02};
    byte exp0[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: send request
  {
    byte req1[2] = {0x27, 0x03};
    byte exp1[6] = {0x67, 0x03, 0x0B, 0x7C, 0xED, 0x5E};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: send request
  {
    byte req2[6] = {0x27, 0x04, 0x20, 0xA9, 0x2D, 0xBA};
    byte exp2[2] = {0x67, 0x04};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: send request
  {
    byte req3[4] = {0x31, 0x01, 0x02, 0x03};
    // interim frame(s) expected first: 7F 31 78 (response pending; handled by the diag layer)
    byte exp3[5] = {0x71, 0x01, 0x02, 0x03, 0x02};
    SendAndCheck(req3, 4, exp3, 5, "step 3");
  }
}

