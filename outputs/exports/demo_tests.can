/* Malformed-length reads of DID driver_door_lock_state (0x0110) are rejected
 * category=negative template=read_did_invalid_length requirements=REQ-010 origin=generated
 * Preconditions: ECU in default session (0x01)
 * Pass criteria: All 4 requests must get exactly the expected bytes. Action under test: ECU replies 62 01 10 01 (positive) within P2 = 50 ms.
 */
testcase TC_req_010__tpl_read_badlen_0110_01()
{
  testCaseTitle("req_010__tpl_read_badlen_0110_01", "Malformed-length reads of DID driver_door_lock_state (0x0110) are rejected");
  // step 0: ReadDataByIdentifier without any DID -> length NRC.
  {
    byte req0[1] = {0x22};
    byte exp0[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req0, 1, exp0, 3, "step 0");
  }
  // step 1: Only the first byte of DID 0x0110 -> length NRC.
  {
    byte req1[2] = {0x22, 0x01};
    byte exp1[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req1, 2, exp1, 3, "step 1");
  }
  // step 2: DID 0x0110 plus one dangling byte -> length NRC, no partial answer.
  {
    byte req2[4] = {0x22, 0x01, 0x10, 0x00};
    byte exp2[3] = {0x7F, 0x22, 0x13};
    SendAndCheck(req2, 4, exp2, 3, "step 2");
  }
  // step 3: Well-formed read of the same DID -> served normally.
  {
    byte req3[3] = {0x22, 0x01, 0x10};
    byte exp3[4] = {0x62, 0x01, 0x10, 0x01};
    SendAndCheck(req3, 3, exp3, 4, "step 3");
  }
}

/* Session change re-locks security level 0x3
 * category=security template=session_change_relocks_security requirements=REQ-010 origin=generated
 * Preconditions: ECU in programming session (0x02); No security level unlocked
 * Pass criteria: All 6 requests must get exactly the expected bytes. Action under test: ECU replies 67 03 A8 19 8A FB (positive) within P2 = 50 ms.
 */
testcase TC_req_010__tpl_session_relock_03()
{
  testCaseTitle("req_010__tpl_session_relock_03", "Session change re-locks security level 0x3");
  // step 0: Switch to session 0x2.
  {
    byte req0[2] = {0x10, 0x02};
    byte exp0[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed for level 0x3.
  {
    byte req1[2] = {0x27, 0x03};
    byte exp1[6] = {0x67, 0x03, 0x0B, 0x7C, 0xED, 0x5E};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send computed key for level 0x3.
  {
    byte req2[6] = {0x27, 0x04, 0x20, 0xA9, 0x2D, 0xBA};
    byte exp2[2] = {0x67, 0x04};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Re-enter the same session -> security must be locked again.
  {
    byte req3[2] = {0x10, 0x02};
    byte exp3[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req3, 2, exp3, 6, "step 3");
  }
  // step 4: Secured write to 0x0160 after re-entry -> expect NRC 0x33.
  {
    byte req4[5] = {0x2E, 0x01, 0x60, 0x00, 0x00};
    byte exp4[3] = {0x7F, 0x2E, 0x33};
    SendAndCheck(req4, 5, exp4, 3, "step 4");
  }
  // step 5: Request seed -> a fresh non-zero seed (level is locked again).
  {
    byte req5[2] = {0x27, 0x03};
    byte exp5[6] = {0x67, 0x03, 0xA8, 0x19, 0x8A, 0xFB};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
}


