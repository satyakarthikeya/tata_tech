/*
 * UNVERIFIED TEMPLATE — not compiled or run in CANoe
 * FOR SIMULATOR OR APPROVED LAB BENCH ONLY. NEVER RUN AGAINST A PRODUCTION VEHICLE.
 *
 * Generated by uds_assistant.export.to_capl from 8 test case(s).
 * Request/response bytes are copied verbatim from the test cases (templates +
 * rules-engine oracle, or the hand-written gold set). The ECU spec is SYNTHETIC.
 * Adapt the diagnostic target / CDD binding before use; review every test.
 *
 * NOTE: not generated by this template: configure in your CANoe environment:
 *   - the diagnostic target (ECU qualifier / CDD / ODX) the diagRequest objects bind to;
 *   - tester-side session keep-alive (TesterPresent) and the S3 timer behaviour;
 *   - handling of 7F xx 78 response-pending frames (the diag layer must absorb them);
 *   - bench set-up for the simulator-only steps (vehicle speed, NVM fault, DTC injection),
 *     which appear below as "not generated" notes;
 *   - the security-access seed/key algorithm (keys here are fixed bytes for the SYNTHETIC ECU);
 *   - test-module configuration (test environment, verdict handling, report generation).
 */

includes
{
}

variables
{
  const dword kP2TimeoutMs = 2000;      // generous tester-side timeout per request
  const dword kSilenceWaitMs = 300;     // wait used when no response is expected
}

/* Send raw request bytes and compare the final response with the expected bytes.
 * expectedLen == 0 means "no response expected" (suppressed positive response). */
int SendAndCheck(byte req[], dword reqLen, byte expected[], dword expectedLen, char stepName[])
{
  diagRequest * rawReq;
  diagResponse * rawResp;
  dword i;
  long waitResult;
  byte actual[4095];
  long actualLen;

  diagResize(rawReq, reqLen);
  for (i = 0; i < reqLen; i++)
    diagSetPrimitiveByte(rawReq, i, req[i]);
  diagSendRequest(rawReq);

  if (expectedLen == 0)
  {
    waitResult = testWaitForDiagResponse(rawReq, kSilenceWaitMs);
    if (waitResult == 1)
    {
      testStepFail(stepName, "Unexpected response (positive response should be suppressed)");
      return 0;
    }
    testStepPass(stepName, "No response, as expected");
    return 1;
  }

  waitResult = testWaitForDiagResponse(rawReq, kP2TimeoutMs);
  if (waitResult != 1)
  {
    testStepFail(stepName, "No response within timeout");
    return 0;
  }
  diagGetLastResponse(rawReq, rawResp);
  actualLen = diagGetPrimitiveSize(rawResp);
  if (actualLen != expectedLen)
  {
    testStepFail(stepName, "Response length %d, expected %d", actualLen, expectedLen);
    return 0;
  }
  for (i = 0; i < expectedLen; i++)
  {
    actual[i] = diagGetPrimitiveByte(rawResp, i);
    if (actual[i] != expected[i])
    {
      testStepFail(stepName, "Byte %d is 0x%02X, expected 0x%02X", i, actual[i], expected[i]);
      return 0;
    }
  }
  testStepPass(stepName, "Response matches");
  return 1;
}


/* Read DID driver_door_lock_state (0x0110) positively in session 0x1
 * category=positive template=read_did_positive requirements=REQ-010 origin=generated
 * Preconditions: ECU in default session (0x01)
 * Pass criteria: ECU replies 62 01 10 01 (positive) within P2 = 50 ms.
 */
testcase TC_req_010__tpl_read_did_positive_0110_01()
{
  testCaseTitle("req_010__tpl_read_did_positive_0110_01", "Read DID driver_door_lock_state (0x0110) positively in session 0x1");
  // step 0: Read DID 0x0110 (driver_door_lock_state) in session 0x1.
  {
    byte req0[3] = {0x22, 0x01, 0x10};
    byte exp0[4] = {0x62, 0x01, 0x10, 0x01};
    SendAndCheck(req0, 3, exp0, 4, "step 0");
  }
}

/* Seed request while security level 0x3 is already unlocked
 * category=security template=seed_request_while_unlocked requirements=REQ-010 origin=generated
 * Preconditions: ECU in programming session (0x02); Security level 0x03 unlocked
 * Pass criteria: All 6 requests must get exactly the expected bytes. Action under test: ECU replies 67 03 00 00 00 00 (positive) within P2 = 50 ms.
 */
testcase TC_req_010__tpl_seed_while_unlocked_03()
{
  testCaseTitle("req_010__tpl_seed_while_unlocked_03", "Seed request while security level 0x3 is already unlocked");
  // step 0: Switch to session 0x2.
  {
    byte req0[2] = {0x10, 0x02};
    byte exp0[6] = {0x50, 0x02, 0x00, 0x32, 0x01, 0xF4};
    SendAndCheck(req0, 2, exp0, 6, "step 0");
  }
  // step 1: Request seed for level 0x3.
  {
    byte req1[2] = {0x27, 0x03};
    byte exp1[6] = {0x67, 0x03, 0x0B, 0x7C, 0xED, 0x5E};
    SendAndCheck(req1, 2, exp1, 6, "step 1");
  }
  // step 2: Send computed key for level 0x3.
  {
    byte req2[6] = {0x27, 0x04, 0x20, 0xA9, 0x2D, 0xBA};
    byte exp2[2] = {0x67, 0x04};
    SendAndCheck(req2, 6, exp2, 2, "step 2");
  }
  // step 3: Request a seed again while the level is unlocked -> 'already unlocked' seed.
  {
    byte req3[2] = {0x27, 0x03};
    byte exp3[6] = {0x67, 0x03, 0x00, 0x00, 0x00, 0x00};
    SendAndCheck(req3, 2, exp3, 6, "step 3");
  }
  // step 4: Protected write to 0x0160 -> still accepted (level stays unlocked).
  {
    byte req4[5] = {0x2E, 0x01, 0x60, 0x00, 0x00};
    byte exp4[3] = {0x6E, 0x01, 0x60};
    SendAndCheck(req4, 5, exp4, 3, "step 4");
  }
  // step 5: Request a seed once more -> still the 'already unlocked' answer.
  {
    byte req5[2] = {0x27, 0x03};
    byte exp5[6] = {0x67, 0x03, 0x00, 0x00, 0x00, 0x00};
    SendAndCheck(req5, 2, exp5, 6, "step 5");
  }
}

